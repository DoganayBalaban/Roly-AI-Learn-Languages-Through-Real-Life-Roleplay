{
  "cli": {
    "version": ">= 16.10.1",
    "appVersionSource": "remote"
  },
"build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      
      "appVersionSource": "local", 
      "android": {
        "buildType": "app-bundle"
      }
    },
    
    
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
