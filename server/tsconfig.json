{
  "compilerOptions": {
    /* Temel Ayarlar */
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "es2016",           
    "module": "commonjs",         /* Node.js için en stabil mod */
    "moduleResolution": "node",
    
    /* Import Uyumluluğu (Çok Önemli) */
    "esModuleInterop": true,      /* 'import express from "express"' yazabilmeni sağlar */
    "skipLibCheck": true,         /* Kütüphane tip dosyalarındaki hataları görmezden gelir */
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* Katı Kurallar */
    "strict": true,
    "noImplicitAny": true,
    
    /* Sorun Çıkaran Ayarları Kapattık */
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}